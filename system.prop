# System properties for the Meizu M6T.
# Vendor properties live in vendor.prop.

ro.forge.meizu.expect_codename=M6T

# Display
# Keep HWC enabled; GPU-only composition causes system-wide UI lag.
debug.sf.disable_hwc=0

# Navigation
# The capacitive keys need a vendor stack this tree does not ship, so keep
# the on-screen navigation bar.
qemu.hw.mainkeys=0
